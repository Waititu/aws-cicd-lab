{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ArtifactBucketAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketVersioning",
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::aws-cicd-lab-pipeline-artifacts-042731792526"
    },
    {
      "Sid": "ArtifactObjectAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject",
        "s3:PutObjectAcl"
      ],
      "Resource": "arn:aws:s3:::aws-cicd-lab-pipeline-artifacts-042731792526/*"
    }
  ]
}
